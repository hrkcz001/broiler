// Resources for broiler-tray.exe.
// RT_MANIFEST (type 24) id 1 is the process manifest used by the loader.

#pragma code_page(65001)

1 24 "broiler.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "hrkcz001"
            VALUE "FileDescription", "broiler tray and coordinator"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "broiler-tray"
            VALUE "LegalCopyright", "Copyright hrkcz001 2026"
            VALUE "OriginalFilename", "broiler-tray.exe"
            VALUE "ProductName", "broiler"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
