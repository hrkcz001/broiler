{
    "version": "$version",
    "description": "Lightweight DDC/CI brightness and contrast control for external monitors.",
    "homepage": "https://github.com/hrkcz001/broiler",
    "license": "Apache-2.0",
    "notes": [
        "Start with Windows is off by default; enable it from the tray Settings window or with:",
        "    broiler settings set startup.launch_at_login true",
        "Scoop retains persisted data; inspect paths with broiler paths --json. Migrate old AppData config explicitly."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/hrkcz001/broiler/releases/download/v$version/broiler-$version-windows-x64.zip",
            "hash": "$sha256"
        }
    },
    "bin": "broiler.exe",
    "persist": "data",
    "pre_install": [
        "New-Item -ItemType Directory -Path (Join-Path $dir 'data') -Force | Out-Null",
        "New-Item -ItemType File -Path (Join-Path $dir 'broiler.portable') -Force | Out-Null"
    ],
    "shortcuts": [["broiler-tray.exe", "broiler"]],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/hrkcz001/broiler/releases/download/v$version/broiler-$version-windows-x64.zip"
            }
        }
    }
}
